# Backend environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# GitHub Personal Access Token (Optional for public repos)
# Increases rate limit from 60 req/hr to 5000 req/hr.
GITHUB_TOKEN=

# AI Provider Selection ("auto", "gemini", or "claude")
AI_PROVIDER=auto

# Google Gemini API key
# Free tier from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Anthropic Claude API key (Optional alternative)
# From: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000
